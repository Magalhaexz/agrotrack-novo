# ── Cliente (VITE_ — vão para o bundle do browser) ──────────────────────────
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY
VITE_APP_URL=http://localhost:5173
VITE_CHECKOUT_URL=http://localhost:5173/minha-assinatura
# Opcional: emails de admin separados por vírgula. Fallback hardcoded em userAccess.js se omitido.
# VITE_HERDON_BOOTSTRAP_ADMIN_EMAILS=admin@exemplo.com,outro@exemplo.com

# ── Servidor (api/ — NUNCA colocar em variável VITE_) ────────────────────────
# Supabase server-side (mesma URL, chave diferente — service_role bypassa RLS)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY

# Asaas billing
ASAAS_ENV=sandbox
# Use ASAAS_API_BASE_URL ou ASAAS_BASE_URL (alias) para o host da API.
ASAAS_API_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=SERVER_ONLY_KEY
ASAAS_WEBHOOK_TOKEN=SERVER_ONLY_TOKEN
