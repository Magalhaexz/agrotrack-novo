# ── Cliente (VITE_ — vão para o bundle do browser) ──────────────────────────
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PUBLIC_ANON_KEY
VITE_APP_URL=http://localhost:5173
VITE_CHECKOUT_URL=http://localhost:5173/minha-assinatura
# Opcional: emails de admin separados por vírgula. Fallback hardcoded em userAccess.js se omitido.
# VITE_HERDON_BOOTSTRAP_ADMIN_EMAILS=admin@exemplo.com,outro@exemplo.com

# ── Servidor (api/ — NUNCA colocar em variável VITE_) ────────────────────────
# Supabase server-side (mesma URL, chave diferente — service_role bypassa RLS)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY

# Asaas billing
ASAAS_ENV=sandbox
# Use ASAAS_API_BASE_URL ou ASAAS_BASE_URL (alias) para o host da API.
ASAAS_API_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=SERVER_ONLY_KEY
ASAAS_WEBHOOK_TOKEN=SERVER_ONLY_TOKEN

# Telegram — multiusuário (Sprint 7, ver docs/SPRINT7_TELEGRAM_MULTIUSUARIO_RESULTADO.md)
# Token do bot, obtido com o @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=SERVER_ONLY_BOT_TOKEN
# Username público do bot (sem @, com ou sem @ tanto faz — api/telegram-gerar-codigo.js
# remove sozinho). Server-side de propósito: usado só para montar o
# "telegramUrl" (deep link + QR Code) retornado pela API; nunca lido pelo
# frontend/bundle. Sem esta variável, a tela mostra só o código textual.
TELEGRAM_BOT_USERNAME=herdon_alertas_bot
# Secret enviado pelo Telegram no header X-Telegram-Bot-Api-Secret-Token
# (configurado via setWebhook?secret_token=...). Sem isto o webhook aceita
# qualquer chamada — configure em produção.
TELEGRAM_WEBHOOK_SECRET=SERVER_ONLY_WEBHOOK_SECRET
# Segredo do endpoint de relatório — obrigatório como "Authorization: Bearer <valor>".
TELEGRAM_REPORT_SECRET=SERVER_ONLY_SHARED_SECRET
# Se definido, a Vercel injeta "Authorization: Bearer <valor>" automaticamente
# nas chamadas do Cron Job — use o mesmo valor de TELEGRAM_REPORT_SECRET.
CRON_SECRET=SERVER_ONLY_SHARED_SECRET

# Telegram — legado (Sprint 6, MVP de conta única). Não recomendado para
# produção multiusuário; api/telegram-relatorio-diario.js não lê mais estas
# variáveis, mantidas aqui só para referência histórica.
# TELEGRAM_CHAT_ID=SERVER_ONLY_CHAT_ID
# TELEGRAM_OWNER_USER_ID=SERVER_ONLY_OWNER_UUID
